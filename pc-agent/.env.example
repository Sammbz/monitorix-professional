# Copy this file to .env and fill in ENROLLMENT_TOKEN (required). Get the
# token from the admin dashboard: Organization > Enrollment tokens.
#
# The agent never signs in as a user — the token is what authorizes it to
# write devices/events for your organization, validated server-side on
# every call. It grants nothing beyond that one organization's data even
# if it leaks. No per-employee login, no password on this machine.
ENROLLMENT_TOKEN=

# Override only if you need a different Supabase project than the bundled
# default. Never a secret either way — see the comment in config.py.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Defaults to the machine's hostname if unset. Set this explicitly so each
# PC shows up as a clearly named, separate device in the dashboard.
DEVICE_NAME=

# Semicolon-separated list of folders to watch for file/folder changes.
# Defaults to Desktop, Documents, Downloads (whichever exist) if unset.
WATCH_PATHS=

FILE_WATCH_RECURSIVE=true
FILE_EVENT_COOLDOWN_SECONDS=1.0
USB_POLL_INTERVAL_SECONDS=2.0
PROCESS_POLL_INTERVAL_SECONDS=2.0
PROCESS_MIN_VISIBLE_SECONDS=6.0
PROCESS_ONLY_USER_APPS=true
# Show a system-tray icon so the user can see monitoring is active, open the
# logs, and quit. Transparent by default (recommended for GDPR); set to false
# for a fully invisible agent.
SHOW_TRAY_ICON=true
# How often (seconds) the agent pings the dashboard to show as "online"
# even when idle. The dashboard flags a device offline after ~3 intervals.
HEARTBEAT_INTERVAL_SECONDS=30.0
SUPABASE_TIMEOUT_SECONDS=10.0
LOG_LEVEL=INFO
# Optional: also write logs to this file (rotating, 5MB x 2). Required in
# practice when the agent runs headless via install-autostart.ps1 —
# pythonw.exe has no console, so this is the only place logs go.
LOG_FILE=

