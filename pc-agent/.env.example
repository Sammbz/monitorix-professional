# Copy this file to .env and fill in your values. Never commit .env.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security entirely — this is
# what lets the agent write events without a logged-in user session. Get it
# from Supabase Project Settings > API > service_role (the SECRET key, not
# the anon/public one). Never put this key in the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# The Supabase auth user id that owns devices created by this agent. Find it
# in Supabase Authentication > Users, under the account you sign into the
# mobile app with — click the user and copy their UID.
DEVICE_USER_ID=00000000-0000-0000-0000-000000000000

# Defaults to the machine's hostname if unset.
DEVICE_NAME=

# Semicolon-separated list of folders to watch for file/folder changes.
# Defaults to Desktop, Documents, Downloads (whichever exist) if unset.
WATCH_PATHS=

FILE_WATCH_RECURSIVE=true
FILE_EVENT_COOLDOWN_SECONDS=1.0
USB_POLL_INTERVAL_SECONDS=2.0
PROCESS_POLL_INTERVAL_SECONDS=2.0
PROCESS_MIN_VISIBLE_SECONDS=6.0
PROCESS_ONLY_USER_APPS=true
SUPABASE_TIMEOUT_SECONDS=10.0
LOG_LEVEL=INFO
