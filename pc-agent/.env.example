# Copy this file to .env and fill in your values. Never commit .env.
#
# Same URL and anon key as the mobile app (Project Settings > API > anon
# public). This is NOT a secret admin key — the agent signs in with a real
# account (prompted on first run) and Row Level Security scopes everything
# to that account, exactly like the mobile app.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Defaults to the machine's hostname if unset.
DEVICE_NAME=

# Semicolon-separated list of folders to watch for file/folder changes.
# Defaults to Desktop, Documents, Downloads (whichever exist) if unset.
WATCH_PATHS=

FILE_WATCH_RECURSIVE=true
FILE_EVENT_COOLDOWN_SECONDS=1.0
USB_POLL_INTERVAL_SECONDS=2.0
PROCESS_POLL_INTERVAL_SECONDS=2.0
PROCESS_MIN_VISIBLE_SECONDS=6.0
PROCESS_ONLY_USER_APPS=true
SUPABASE_TIMEOUT_SECONDS=10.0
LOG_LEVEL=INFO
